<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_dragonball"
    tools:context=".MenuActivity">

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraInferior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <include
                android:id="@+id/cabecera_logo"
                layout="@layout/estampaslogo"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="-20dp" />

            <LinearLayout
                android:id="@+id/linearLayoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_DragonBall"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_menu_neon"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:text="DRAGON BALL S"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_DBN"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_menu_neon"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:text="DRAGON BALL S ULTIMATE WARRIORS"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_TLOSG"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_menu_neon"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:text="DRAGON BALL S THE LEGEND OF SON GOKU"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_DBUCT"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_menu_neon"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:text="DRAGON BALL UNIVERSAL COLLECTION TARJETAS"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_DBUCE"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_menu_neon"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:text="DRAGON BALL UNIVERSAL ESTAMPAS"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_DBU"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_menu_neon"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:text="DRAGON BALL ULTIMATE"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:background="#CC1E1E1E"
        android:gravity="center"
        android:paddingBottom="45dp"
        android:paddingTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:text="Regresar"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:textAllCaps="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
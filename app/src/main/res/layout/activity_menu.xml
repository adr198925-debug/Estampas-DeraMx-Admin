<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_menu"
    tools:context=".MenuActivity">

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <include
                android:id="@+id/cabecera_logo"
                layout="@layout/estampaslogo"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="-20dp" />

            <LinearLayout
                android:id="@+id/linearLayoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="-40dp">

                <Button
                    android:id="@+id/btn_DragonBall"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="15dp"
                    android:text="Dragon Ball"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#5D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_DBUW"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Naruto"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_TLOSG"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Captain Tsubasa"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_DBUCT"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Spiderverse"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_DBUCE"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Mario Bros"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_DBU"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Harry Potter"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_CaballerosdelZodiaco"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Caballeros del zodiaco"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

                <Button
                    android:id="@+id/btn_Yugioh"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="13dp"
                    android:text="Yugioh"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold|italic"
                    android:gravity="center_vertical|start"
                    android:paddingStart="30dp"
                    android:backgroundTint="#4D000000"
                    app:cornerRadius="15dp"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#CC000000"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="#FF8000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar"
                android:textColor="#FF8000"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
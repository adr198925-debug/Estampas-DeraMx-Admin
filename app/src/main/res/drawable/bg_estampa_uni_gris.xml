<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo negro -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#000000"/>
        </shape>
    </item>

    <!-- Aro rojo exterior -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="3dp"
                android:color="#FF0000"/>
        </shape>
    </item>

    <!-- Aro rojo interior -->
    <item
        android:left="40dp"
        android:top="40dp"
        android:right="40dp"
        android:bottom="40dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="2dp"
                android:color="#990000"/>
        </shape>

    </item>

</layer-list>
